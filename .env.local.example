# Copy this file to `.env.local` and fill in your values.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed. The e2e harness
# (examples/e2e) loads it automatically; real environment variables, if set,
# take precedence over what's in this file.

# Required for any real API call. Your Quickpay API key (manager > Settings > API user).
QUICKPAY_API_KEY=

# Required to verify callbacks. Your account private key (manager > Settings > Integration).
# This is DIFFERENT from the API key above.
QUICKPAY_PRIVATE_KEY=

# Optional. The public https URL from `expose share`, used as the callback base when creating a
# payment link. It changes every session on the Expose free tier.
QUICKPAY_CALLBACK_BASE=

# Optional. Your expose.dev auth token (only used by the Expose client Docker container).
EXPOSE_TOKEN=
